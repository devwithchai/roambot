{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devwithchai/roambot/blob/feat/mission-policy-manager/config/mission_policy.schema.json",
  "title": "RoamBot Mission Operational Policy",
  "description": "Declarative warehouse operational policy. Runtime application requires deterministic validation and a policy adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "robots", "condition", "constraints", "priority"],
  "properties": {
    "policy_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,63}$"
    },
    "robots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["scout", "service"] }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": {
          "type": "string",
          "enum": ["always", "forklift_operating"]
        },
        "aisle": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "restricted_regions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          }
        },
        "preferred_routes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          }
        }
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "valid": {
      "type": "boolean",
      "default": true
    }
  }
}
