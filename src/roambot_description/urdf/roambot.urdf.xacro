<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roambot">
  <xacro:arg name="model_name" default="roambot"/>
  <xacro:arg name="frame_prefix" default=""/>
  <xacro:arg name="enable_camera" default="false"/>

  <xacro:property name="model_name" value="$(arg model_name)"/>
  <xacro:property name="frame_prefix" value="$(arg frame_prefix)"/>
  <xacro:property name="enable_camera" value="$(arg enable_camera)"/>

  <!-- Four-wheel chassis: 0.66 m long, 0.51 m wide including the wheels. -->
  <xacro:property name="body_length" value="0.70"/>
  <xacro:property name="body_width" value="0.42"/>
  <xacro:property name="body_height" value="0.08"/>
  <xacro:property name="body_z" value="0.12"/>
  <xacro:property name="body_round_radius" value="${body_width / 2.0}"/>
  <xacro:property name="body_straight_length" value="${body_length - 2.0 * body_round_radius}"/>
  <xacro:property name="body_end_x" value="${body_straight_length / 2.0}"/>

  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.045"/>
  <xacro:property name="wheel_y" value="${body_width / 2.0 + wheel_width / 2.0}"/>
  <xacro:property name="front_wheel_x" value="0.20"/>
  <xacro:property name="rear_wheel_x" value="-0.20"/>
  <xacro:property name="wheel_z" value="${-body_z + wheel_radius}"/>

  <xacro:property name="deck_height" value="0.03"/>
  <xacro:property name="pillar_height" value="0.07"/>
  <xacro:property name="pillar_radius" value="0.014"/>

  <!-- Original RoamBot colour palette. -->
  <material name="body_color"><color rgba="0.12 0.34 0.20 1"/></material>
  <material name="deck_color"><color rgba="0.28 0.34 0.23 1"/></material>
  <material name="metal"><color rgba="0.72 0.74 0.76 1"/></material>
  <material name="dark_metal"><color rgba="0.26 0.28 0.30 1"/></material>
  <material name="wheel_color"><color rgba="0.58 0.36 0.20 1"/></material>
  <material name="pillar_gold"><color rgba="0.83 0.62 0.12 1"/></material>
  <material name="camera_lens_silver"><color rgba="0.78 0.80 0.82 1"/></material>
  <material name="tote_color"><color rgba="0.30 0.34 0.38 1"/></material>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="${mass * (3*radius*radius + length*length) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (3*radius*radius + length*length) / 12.0}" iyz="0"
        izz="${mass * radius*radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${body_z}"/>
  </joint>

  <!-- Rounded, longer mobile base. The box and end cylinders form a capsule. -->
  <link name="base_link">
    <visual>
      <geometry><box size="${body_straight_length} ${body_width} ${body_height}"/></geometry>
      <material name="body_color"/>
    </visual>
    <visual>
      <origin xyz="${body_end_x} 0 0"/>
      <geometry><cylinder radius="${body_round_radius}" length="${body_height}"/></geometry>
      <material name="body_color"/>
    </visual>
    <visual>
      <origin xyz="${-body_end_x} 0 0"/>
      <geometry><cylinder radius="${body_round_radius}" length="${body_height}"/></geometry>
      <material name="body_color"/>
    </visual>
    <collision>
      <geometry><box size="${body_straight_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <collision>
      <origin xyz="${body_end_x} 0 0"/>
      <geometry><cylinder radius="${body_round_radius}" length="${body_height}"/></geometry>
    </collision>
    <collision>
      <origin xyz="${-body_end_x} 0 0"/>
      <geometry><cylinder radius="${body_round_radius}" length="${body_height}"/></geometry>
    </collision>
    <xacro:box_inertial mass="10.0" x="${body_length}" y="${body_width}" z="${body_height}"/>
  </link>

  <!-- Low triangular deck above the chassis. -->
  <link name="upper_deck_link">
    <visual>
      <geometry><box size="0.38 0.30 ${deck_height}"/></geometry>
      <material name="deck_color"/>
    </visual>
    <visual>
      <origin xyz="0.17 0 0.025"/>
      <geometry><box size="0.05 0.30 0.04"/></geometry>
      <material name="metal"/>
    </visual>
    <xacro:box_inertial mass="1.1" x="0.38" y="0.30" z="${deck_height}"/>
  </link>

  <joint name="upper_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="upper_deck_link"/>
    <origin xyz="0 0 ${body_height / 2.0 + pillar_height + deck_height / 2.0}"/>
  </joint>

  <xacro:macro name="deck_pillar" params="name x y">
    <link name="${name}_link">
      <visual>
        <geometry><cylinder radius="${pillar_radius}" length="${pillar_height}"/></geometry>
        <material name="pillar_gold"/>
      </visual>
      <xacro:cylinder_inertial mass="0.06" radius="${pillar_radius}" length="${pillar_height}"/>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${body_height / 2.0 + pillar_height / 2.0}"/>
    </joint>
  </xacro:macro>

  <xacro:deck_pillar name="front_left_pillar" x="0.14" y="0.11"/>
  <xacro:deck_pillar name="front_right_pillar" x="0.14" y="-0.11"/>
  <xacro:deck_pillar name="rear_pillar" x="-0.16" y="0"/>

  <!--
    Tote carrier chain
    base_link -> lift_mast_link -> lift_carriage_link -> tote_slide_link -> carried_tote_link
    The tray is supported by the carriage, not placed in mid-air.
  -->
  <link name="lift_mast_link">
    <visual>
      <origin xyz="0 0.07 0"/>
      <geometry><box size="0.055 0.030 0.76"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 -0.07 0"/>
      <geometry><box size="0.055 0.030 0.76"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.325"/>
      <geometry><box size="0.060 0.17 0.05"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.325"/>
      <geometry><box size="0.070 0.18 0.07"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <xacro:box_inertial mass="1.8" x="0.07" y="0.18" z="0.76"/>
  </link>

  <joint name="lift_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lift_mast_link"/>
    <origin xyz="-0.16 0 0.52"/>
  </joint>

  <!--
    The carrier starts on the upper-deck surface.  Every carriage and tray
    visual begins at z=0 or above, so no part enters the deck at lift=0.
  -->
  <link name="lift_carriage_link">
    <!-- Two guide shoes visibly lock the carriage to the mast rails. -->
    <visual>
      <origin xyz="0 0.070 0.055"/>
      <geometry><box size="0.090 0.060 0.110"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0 -0.070 0.055"/>
      <geometry><box size="0.090 0.060 0.110"/></geometry>
      <material name="metal"/>
    </visual>
    <!-- A cross-head joins the guide shoes; it remains part of the mast. -->
    <visual>
      <origin xyz="0 0 0.055"/>
      <geometry><box size="0.090 0.180 0.060"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <!-- Narrow fixed rails support the sliding tray at the same deck level. -->
    <visual>
      <origin xyz="0.260 0.130 0.020"/>
      <geometry><box size="0.440 0.030 0.040"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <visual>
      <origin xyz="0.260 -0.130 0.020"/>
      <geometry><box size="0.440 0.030 0.040"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <visual>
      <origin xyz="0.070 0 0.020"/>
      <geometry><box size="0.040 0.290 0.040"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <xacro:box_inertial mass="1.2" x="0.53" y="0.29" z="0.12"/>
  </link>

  <joint name="lift_joint" type="prismatic">
    <parent link="lift_mast_link"/>
    <child link="lift_carriage_link"/>
    <origin xyz="0 0 -0.38"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.56" effort="350" velocity="0.18"/>
    <dynamics damping="30" friction="3"/>
  </joint>

  <!-- The tray sits on the same plane as the fixed carriage rails. -->
  <link name="tote_slide_link">
    <visual>
      <origin xyz="0.220 0 0.020"/>
      <geometry><box size="0.400 0.240 0.040"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0.220 0.1125 0.075"/>
      <geometry><box size="0.400 0.015 0.110"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <visual>
      <origin xyz="0.220 -0.1125 0.075"/>
      <geometry><box size="0.400 0.015 0.110"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <visual>
      <origin xyz="0.035 0 0.075"/>
      <geometry><box size="0.015 0.240 0.110"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <xacro:box_inertial mass="0.8" x="0.400" y="0.240" z="0.13"/>
  </link>

  <joint name="tote_slide_joint" type="prismatic">
    <parent link="lift_carriage_link"/>
    <child link="tote_slide_link"/>
    <origin xyz="0.080 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.20" effort="250" velocity="0.14"/>
    <dynamics damping="25" friction="2"/>
  </joint>

  <!-- A neutral tote stays seated on the tray and demonstrates the full mechanism. -->
  <link name="carried_tote_link">
    <visual>
      <origin xyz="0.220 0 0.055"/>
      <geometry><box size="0.26 0.17 0.015"/></geometry>
      <material name="tote_color"/>
    </visual>
    <visual>
      <origin xyz="0.220 0.0775 0.1075"/>
      <geometry><box size="0.26 0.015 0.100"/></geometry>
      <material name="tote_color"/>
    </visual>
    <visual>
      <origin xyz="0.220 -0.0775 0.1075"/>
      <geometry><box size="0.26 0.015 0.100"/></geometry>
      <material name="tote_color"/>
    </visual>
    <visual>
      <origin xyz="0.0975 0 0.1075"/>
      <geometry><box size="0.015 0.17 0.100"/></geometry>
      <material name="tote_color"/>
    </visual>
    <visual>
      <origin xyz="0.3425 0 0.1075"/>
      <geometry><box size="0.015 0.17 0.100"/></geometry>
      <material name="tote_color"/>
    </visual>
    <xacro:box_inertial mass="0.45" x="0.32" y="0.24" z="0.16"/>
  </link>

  <joint name="carried_tote_joint" type="fixed">
    <parent link="tote_slide_link"/>
    <child link="carried_tote_link"/>
  </joint>

  <!--
    Navigation baseline: true differential drive.
    The two front wheels provide propulsion.  Rear wheel shapes are visual only;
    a low-friction support ball carries the rear of the chassis during turns.
    This avoids treating a four-fixed-wheel chassis as an ideal differential
    drive, which locks the physical model during in-place rotation.
  -->
  <xacro:macro name="drive_wheel" params="name x y">
    <link name="${name}_wheel_link">
      <visual>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_color"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertial mass="0.65" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_z}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel name="front_left" x="${front_wheel_x}" y="${wheel_y}"/>
  <xacro:drive_wheel name="front_right" x="${front_wheel_x}" y="${-wheel_y}"/>

  <!-- Rear wheel trims retain the intended four-wheel visual design. -->
  <xacro:macro name="rear_trim_wheel" params="name y">
    <link name="${name}_wheel_link">
      <visual>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_color"/>
      </visual>
      <xacro:cylinder_inertial mass="0.10" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>

    <joint name="${name}_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${rear_wheel_x} ${y} ${wheel_z}"/>
    </joint>
  </xacro:macro>

  <xacro:rear_trim_wheel name="rear_left" y="${wheel_y}"/>
  <xacro:rear_trim_wheel name="rear_right" y="${-wheel_y}"/>

  <!-- Low-friction support at the rear: the simulated equivalent of a ball caster. -->
  <link name="rear_ball_caster_link">
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.045"/></geometry>
    </collision>
    <xacro:box_inertial mass="0.15" x="0.09" y="0.09" z="0.09"/>
  </link>

  <joint name="rear_ball_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_ball_caster_link"/>
    <origin xyz="-0.25 0 -0.075"/>
  </joint>

  <!-- Simple front-centre lidar pedestal fixed directly to the base. -->
  <link name="lidar_mount_link">
    <visual>
      <origin xyz="-0.02 0 0.0050"/>
      <geometry><box size="0.080 0.100 0.010"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <xacro:box_inertial mass="0.12" x="0.080" y="0.100" z="0.010"/>
  </link>

  <joint name="lidar_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mount_link"/>
    <origin xyz="0.290 0 ${body_height / 2.0}"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.045"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <xacro:cylinder_inertial mass="0.12" radius="0.035" length="0.045"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mount_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.02 0 0.0325"/>
  </joint>

  <xacro:if value="${enable_camera}">
    <!-- Front-right camera bracket fixed directly to the mobile base. -->
    <link name="camera_mount_link">
      <visual>
        <origin xyz="0.030 0 0.025"/>
        <geometry><box size="0.060 0.080 0.050"/></geometry>
        <material name="dark_metal"/>
      </visual>
      <xacro:box_inertial mass="0.05" x="0.060" y="0.080" z="0.050"/>
    </link>

    <joint name="camera_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_mount_link"/>
      <origin xyz="0.320 0 -0.025"/>
    </joint>

    <link name="camera_link">
      <visual><geometry><box size="0.055 0.060 0.040"/></geometry><material name="dark_metal"/></visual>
      <visual>
        <origin xyz="0.033 0 0" rpy="0 ${pi / 2.0} 0"/>
        <geometry><cylinder radius="0.014" length="0.010"/></geometry>
        <material name="camera_lens_silver"/>
      </visual>
      <xacro:box_inertial mass="0.08" x="0.055" y="0.060" z="0.040"/>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="camera_mount_link"/>
      <child link="camera_link"/>
      <origin xyz="0.055 0 0.025"/>
    </joint>
  </xacro:if>

  <gazebo reference="front_left_wheel_link"><mu1>1.0</mu1><mu2>0.7</mu2></gazebo>
  <gazebo reference="front_right_wheel_link"><mu1>1.0</mu1><mu2>0.7</mu2></gazebo>
  <gazebo reference="rear_ball_caster_link"><mu1>0.05</mu1><mu2>0.05</mu2></gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <topic>/model/${model_name}/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-1.5708</min_angle><max_angle>1.5708</max_angle></horizontal></scan>
        <range><min>0.12</min><max>6.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <xacro:if value="${enable_camera}">
    <gazebo reference="camera_link">
      <sensor name="inventory_camera" type="camera">
        <topic>/model/${model_name}/camera/image</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>5.0</far></clip>
          <camera_info_topic>/model/${model_name}/camera/camera_info</camera_info_topic>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <wheel_separation>0.465</wheel_separation>
      <wheel_radius>0.075</wheel_radius>
      <topic>/model/${model_name}/cmd_vel</topic>
      <odom_topic>/model/${model_name}/odometry</odom_topic>
      <tf_topic>/model/${model_name}/tf</tf_topic>
      <frame_id>${frame_prefix}odom</frame_id>
      <child_frame_id>${frame_prefix}base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>1.0</max_linear_velocity>
      <max_angular_velocity>0.50</max_angular_velocity>
      <max_linear_acceleration>0.70</max_linear_acceleration>
      <max_angular_acceleration>0.50</max_angular_acceleration>
    </plugin>

    <!-- Gazebo commands accept target positions in metres. -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>lift_joint</joint_name>
      <topic>/model/${model_name}/lift/cmd_pos</topic>
      <p_gain>180</p_gain><i_gain>0</i_gain><d_gain>8</d_gain>
      <cmd_max>350</cmd_max><cmd_min>-350</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>tote_slide_joint</joint_name>
      <topic>/model/${model_name}/tote_slide/cmd_pos</topic>
      <p_gain>150</p_gain><i_gain>0</i_gain><d_gain>7</d_gain>
      <cmd_max>250</cmd_max><cmd_min>-250</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/${model_name}/joint_states</topic>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>lift_joint</joint_name>
      <joint_name>tote_slide_joint</joint_name>
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>
</robot>
