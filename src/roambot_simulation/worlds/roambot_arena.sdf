<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="arena">

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.22 0.24 1</ambient>
            <diffuse>0.38 0.38 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer room: 6 m by 6 m -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 3 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.12 0.12 0.80</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.12 0.12 0.80</size></box></geometry><material><diffuse>0.78 0.78 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -3 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.12 0.12 0.80</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.12 0.12 0.80</size></box></geometry><material><diffuse>0.78 0.78 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>3 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 6.12 0.80</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 6.12 0.80</size></box></geometry><material><diffuse>0.78 0.78 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-3 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 6.12 0.80</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 6.12 0.80</size></box></geometry><material><diffuse>0.78 0.78 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Interior structure for turning and obstacle detection -->
    <model name="vertical_partition">
      <static>true</static>
      <pose>0.9 -1.15 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 2.20 0.80</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 2.20 0.80</size></box></geometry><material><diffuse>0.25 0.48 0.68 1</diffuse></material></visual>
      </link>
    </model>

    <model name="horizontal_partition">
      <static>true</static>
      <pose>-1.15 1.15 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.70 0.12 0.80</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.70 0.12 0.80</size></box></geometry><material><diffuse>0.25 0.48 0.68 1</diffuse></material></visual>
      </link>
    </model>

    <model name="centre_block">
      <static>true</static>
      <pose>1.65 0.85 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.50 0.50 0.60</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.50 0.50 0.60</size></box></geometry><material><diffuse>0.78 0.30 0.18 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>